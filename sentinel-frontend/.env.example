# Base URL of the Sentinel Copilot backend API.
#
# Must be prefixed with VITE_ — Vite only exposes VITE_* variables to client
# code, so a plain API_BASE_URL is silently ignored and the app falls back to
# the default in src/services/serviceApi.ts.
#
# The backend listens on :8001. Port 8000 is the SigNoz MCP server.
VITE_API_URL=http://localhost:8001/api/v1
