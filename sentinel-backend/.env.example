# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Copilot Backend — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

PROJECT_NAME="Sentinel Copilot Backend"
ENVIRONMENT="development"

# SigNoz OTLP gRPC endpoint for traces & metrics ingestion
SIGNOZ_OTLP_ENDPOINT="http://localhost:4317"

# SigNoz MCP HTTP JSON-RPC endpoint
SIGNOZ_MCP_URL="http://localhost:8000/mcp"

# SigNoz API key — REQUIRED, not optional, even for a local deployment.
#
# Create one in the SigNoz UI: Settings -> Service Accounts -> create (role
# signoz-admin) -> add key.
#
# Left empty, SentinelMCPClient refuses to construct and copilot/loop.py catches
# the error, so a cycle still reports final_action: investigated_no_kill while
# the investigate and alert stages silently do nothing.
SIGNOZ_API_KEY=""

# Docker socket path (default for Linux / WSL2)
DOCKER_HOST="unix:///var/run/docker.sock"

# Background scanner polling interval in seconds
SCAN_INTERVAL_SECONDS=10
